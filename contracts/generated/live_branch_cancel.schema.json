{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Trusted local operator request for one exact saved mission task.",
  "properties": {
    "expectedTaskVersion": {
      "minimum": 1,
      "title": "Expectedtaskversion",
      "type": "integer"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason",
      "type": "string"
    },
    "requestId": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Requestid",
      "type": "string"
    },
    "runId": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Runid",
      "type": "string"
    },
    "taskId": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Taskid",
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "runId",
    "taskId",
    "expectedTaskVersion",
    "reason"
  ],
  "title": "LiveBranchCancelRequest",
  "type": "object"
}
