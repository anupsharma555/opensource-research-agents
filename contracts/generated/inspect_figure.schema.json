{
  "$defs": {
    "PublicDocumentRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "public_document_fetch",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "title": "PublicDocumentRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "documentRef": {
      "$ref": "#/$defs/PublicDocumentRef"
    },
    "pageNumber": {
      "maximum": 200,
      "minimum": 1,
      "title": "Pagenumber",
      "type": "integer"
    },
    "question": {
      "description": "Specific visual question about this page or figure. Returns an unverified model interpretation, not a checked source passage.",
      "maxLength": 1000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    }
  },
  "required": [
    "documentRef",
    "pageNumber",
    "question"
  ],
  "title": "InspectFigureInput",
  "type": "object"
}
