  "properties": {
    "agentIds": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Agentids",
      "type": "array"
    },
    "evidenceText": {
      "minLength": 1,
      "title": "Evidencetext",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "requestId": {
      "maxLength": 160,
      "minLength": 1,
