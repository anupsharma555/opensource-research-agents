{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agentIds": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Agentids",
      "type": "array"
    },
    "credentialProfile": {
      "anyOf": [
        {
          "enum": [
            "primary",
            "backup"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credentialprofile"
    },
    "evidenceText": {
      "default": "",
      "title": "Evidencetext",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "requestId": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Requestid",
      "type": "string"
    },
    "requiredAgentIds": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "title": "Requiredagentids",
      "type": "array"
    },
    "scope": {
      "default": "",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "question",
    "agentIds"
  ],
  "title": "LiveStartRequest",
  "type": "object"
}
