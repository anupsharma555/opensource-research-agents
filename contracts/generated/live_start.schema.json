{
  "$defs": {
    "LiveAgentModelChoice": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "model": {
                "const": "openai/gpt-oss-120b"
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "properties": {
              "reasoningEffort": {
                "anyOf": [
                  {
                    "enum": [
                      "medium",
                      "high"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      ],
      "description": "Optional per-alias model choice for a new research run.",
      "properties": {
        "maxCompletionTokens": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxcompletiontokens"
        },
        "model": {
          "enum": [
            "openai/gpt-oss-120b",
            "qwen/qwen3.8-27b"
          ],
          "title": "Model",
          "type": "string"
        },
        "reasoningEffort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoningeffort"
        }
      },
      "required": [
        "model"
      ],
      "title": "LiveAgentModelChoice",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agentIds": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Agentids",
      "type": "array"
    },
    "agentModels": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/LiveAgentModelChoice"
          },
          "propertyNames": {
            "maxLength": 160,
            "minLength": 1
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agentmodels"
    },
    "allowVision": {
      "default": false,
      "description": "Explicitly permit auxiliary Groq Qwen figure-reading calls using this run's selected credential profile.",
      "title": "Allowvision",
      "type": "boolean"
    },
    "credentialProfile": {
      "anyOf": [
        {
          "enum": [
            "primary",
            "backup"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credentialprofile"
    },
    "evidenceText": {
      "default": "",
      "title": "Evidencetext",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "requestId": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Requestid",
      "type": "string"
    },
    "requiredAgentIds": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "title": "Requiredagentids",
      "type": "array"
    },
    "scope": {
      "default": "",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "question",
    "agentIds"
  ],
  "title": "LiveStartRequest",
  "type": "object"
}
