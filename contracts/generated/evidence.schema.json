{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accessSurface": {
      "enum": [
        "abstract",
        "full_text",
        "experiment_output"
      ],
      "title": "Accesssurface",
      "type": "string"
    },
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "published_evidence",
        "checked_result"
      ],
      "title": "Kind",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "locators": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Locators",
      "type": "array"
    },
    "missionId": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missionid"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "validationRecord": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Validationrecord",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "version",
    "kind",
    "artifact",
    "locators",
    "validationRecord",
    "accessSurface",
    "summary"
  ],
  "title": "EvidencePacket",
  "type": "object"
}
