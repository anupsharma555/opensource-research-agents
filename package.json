{
  "name": "open-research-agents-stage1-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "npm run generate:types:check && tsc --project ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "test": "vitest run --config ui/vite.config.ts",
    "generate:types": "node scripts/generate-types.mjs",
    "generate:types:check": "node scripts/generate-types.mjs --check",
    "contracts:check": "node scripts/check-contracts.mjs",
    "tauri": "tauri",
    "desktop:dev": "node desktop/run.mjs dev",
    "desktop:build": "node desktop/run.mjs build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.17.1",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
